---
import { PortableText } from 'astro-portabletext';

import Layout from '../../layouts/Layout.astro';
import { getBlogs, getBlogPost } from '../../../sanity/api';
import Code from '../../components/PortableText/Code.astro';
import Image from '../../components/PortableText/Image.astro'
import Link from '../../components/PortableText/Link.astro'
import type { BlogPost } from '@types';
import urlFor from '../../../utils/urlFor';
import { formatDate } from '../../../utils/formatDate';

const components = {
  type: {
    code: Code,
    image: Image
  },
  mark: {
    link: Link
  }
};

export async function getStaticPaths() {
  const allBlogs: BlogPost[] = await getBlogs();
  return Promise.all(allBlogs.map(async (blog: BlogPost) => {
    const post = await getBlogPost(blog.slug.current);
    return {
      params: { slug: blog.slug.current },
      props: { blog: post },
    };
  }));
}

const {
  blog: { title, body, teaser, publishedAt, mainImage },
} = Astro.props;

const shareableImage = mainImage ? urlFor(mainImage).url() : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: teaser,
  ...(shareableImage ? { image: shareableImage } : {}),
  datePublished: publishedAt,
  author: {
    "@type": "Person",
    name: "Adam Fenwick",
  },
  publisher: {
    "@type": "Organization",
    name: "Adam Fenwick",
    logo: {
      "@type": "ImageObject",
      url: "https://afenwick.com/favicon.svg",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `https://afenwick.com${Astro.url.pathname}`,
  },
  url: `https://afenwick.com${Astro.url.pathname}`,
};
---

<style>
  .blog-title {
    margin-bottom: 0;
  }

  .blog-heading {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>

<Layout
  title={`${title} - Adam Fenwick`}
  description={teaser}
  shareableImage={shareableImage}
>
  <main id="main-content" class="main">
    <article>
      <div class="blog-heading">
        <h1 class="blog-title">{title}</h1>
        <time datetime={formatDate(publishedAt)}>{formatDate(publishedAt)}</time>
      </div>
      <p>{teaser}</p>
      <PortableText value={body} components={components} />
    </article>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <a href="/" class="back-link">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M10 13 5 8l5-5" />
      </svg>
      Go back
    </a>
  </main>
</Layout>
