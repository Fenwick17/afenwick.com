---
import Layout from '../layouts/Layout.astro';

import { formatDate } from '../../utils/formatDate';
import { getLatestBlogs } from '../../sanity/api';
import type { BlogPost } from '@types';

const blogs: BlogPost[] = await getLatestBlogs();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Adam Fenwick",
  url: "https://afenwick.com",
  description:
    "Digital accessibility and frontend development — Adam Fenwick",
  inLanguage: "en-GB",
};
---

<style>
  .blog-list {
    padding-left: 0;

    li {
      list-style: none;
    }

    .blog-preview-title {
      margin-bottom: 0;
    }

    .blog-preview-date {
      display: block;
      margin-bottom: 1rem;
    }
  }
</style>

<Layout
  title="Digital accessibility and frontend development — Adam Fenwick"
  description="I am Adam Fenwick, a digital accessibility specialist. My thoughts and musings on digital accessibility and making the web more accessible for everyone."
  shareableImage="/logo-shareable.png"
>
  <main id="main-content" class="main">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <div>
      <h1>Blog</h1>
      <div id="blogs">
        <ul class="blog-list">
          {
            blogs.map((blog) => (
              <li id={blog.slug.current}>
                <h2 class="blog-preview-title">
                  <a class="link" href={`/blog/${blog.slug.current}`} data-cy="blogUrls">{blog.title}</a>
                </h2>
                <time class="blog-preview-date" datetime={formatDate(blog.publishedAt)}>{blog.publishedAt}</time>
                <p>{blog.teaser}</p>
              </li >
            ))
          }
        </ul>
      </div>
    </div>
  </main>
</Layout>
