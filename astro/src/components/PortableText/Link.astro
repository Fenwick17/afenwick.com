---
interface LinkMarkDef {
  _type: string;
  type?: 'internal' | 'external';
  href?: string;
  blank?: boolean;
  internalLink?: {
    slug?: {
      current?: string;
    };
  };
}

const { node } = Astro.props;
const { type, href, blank, internalLink } = node.markDef as LinkMarkDef;

const url =
  type === 'internal' && internalLink?.slug?.current
    ? `/blog/${internalLink.slug.current}`
    : href;
---

{url ? (
  blank ? (
    <a href={url} target="_blank" rel="noopener noreferrer">
      <slot />
    </a>
  ) : (
    <a href={url}>
      <slot />
    </a>
  )
) : (
  <slot />
)}
