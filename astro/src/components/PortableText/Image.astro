---
import { Image } from 'astro:assets';
import urlFor from '../../../utils/urlFor';
import type { Image as SanityImage } from '@types';

interface Props {
  node: SanityImage;
}

const { node } = Astro.props;
const src = urlFor(node).url();
---

<style>
  .blog-post-img {
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>

<Image src={src} alt={node.alt} class="blog-post-img" inferSize />

<style>
  img {
    margin: auto;
    padding: 1em;
  }
</style>
